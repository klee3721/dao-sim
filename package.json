{
  "name": "dao-sim",
  "version": "0.7.2",
  "description": "Ứng dụng macOS và Windows duyệt web, crawl SIM và luận số tự động hoặc hàng loạt.",
  "main": "out/main/index.js",
  "author": "Trung Kien Vu",
  "license": "GPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klee3721/dao-sim.git"
  },
  "bugs": {
    "url": "https://github.com/klee3721/dao-sim/issues"
  },
  "homepage": "https://github.com/klee3721/dao-sim#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon:win": "node scripts/generate-windows-icon.cjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 && node scripts/install-mac-release.cjs arm64",
    "package:mac:dir": "npm run build && electron-builder --mac dir --arm64",
    "package:mac:universal": "npm run build && electron-builder --mac dmg zip --universal && node scripts/install-mac-release.cjs universal",
    "package:win": "npm run build && electron-builder --win nsis zip --x64 --publish never && node scripts/finalize-win-release.cjs x64",
    "package:win:dir": "npm run build && electron-builder --win dir --x64",
    "package:win:verify": "node scripts/verify-win-release.cjs x64"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "papaparse": "^5.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "write-excel-file": "^4.1.1"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "unzipper": "^0.12.5",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "vn.daosim.desktop",
    "productName": "Đào Sim",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Đào Sim",
      "uninstallDisplayName": "Đào Sim",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Đào Sim ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
